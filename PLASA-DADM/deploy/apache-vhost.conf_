<VirtualHost *:80>
    ServerName papem.marinha.local
    DocumentRoot /opt/papem/papem-laravel/public

    # PHP-FPM via socket
    <FilesMatch "\.php$">
        SetHandler "proxy:unix:/run/php/php8.2-fpm-papem.sock|fcgi://localhost"
    </FilesMatch>

    <Directory "/opt/papem/papem-laravel/public">
        Options -Indexes
        AllowOverride All
        Require all granted
    </Directory>

    # SSE: não usar proxy buffering nas rotas de stream
    # (servidas diretamente pelo PHP-FPM via FilesMatch acima)
    ProxyPass /api/documents/stream !
    ProxyPass /api/duty-officers/stream !

    # Limite de upload (100 MB)
    LimitRequestBody 104857600

    # SSE: manter conexão aberta por até 1 hora
    ProxyTimeout 3600
    Header always set X-Accel-Buffering "no"

    # Segurança: ocultar versão do servidor
    ServerTokens Prod

    ErrorLog /var/log/apache2/papem-error.log
    CustomLog /var/log/apache2/papem-access.log combined
</VirtualHost>
